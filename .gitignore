# ---- Build output ----------------------------------------------------------
# Everything CMake generates. Nothing in here belongs in version control:
# it is machine-specific, it is enormous, and it is reproducible from source.
build/
build_output/
out/
cmake-build-*/

# ---- Fetched dependencies --------------------------------------------------
# FetchContent puts SDL, doctest, nlohmann_json and ImGui inside build/, so
# the line above already covers them. Listed explicitly in case you ever
# relocate FETCHCONTENT_BASE_DIR.
_deps/

# ---- IDE and editor --------------------------------------------------------
.vs/
.vscode/
!.vscode/settings.json
.idea/
*.user
*.suo
*.sln
*.sln.docstates
*.vcxproj*
CMakeUserPresets.json
IntelGraphicsProfiles/

# ---- Compiler and linker artefacts -----------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.idb
*.ilk
*.exp
*.tlog
*.lastbuildstate

# ---- Runtime output --------------------------------------------------------
# Week 3's file sink writes here. Logs are evidence, not source - paste the
# interesting lines into a writeup instead of committing the raw file.
logs/
*.log

# Week 2: ImGui writes its own imgui.ini storing the docked panel layout.
# A window arrangement is a personal preference, not source.
imgui.ini

# ---- OS noise --------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Profiler and sanitizer output -----------------------------------------
# Reports are evidence, not source. Paste findings into your writeups instead
# of committing raw dumps.
*.trace
*.heaptrack.*
callgrind.out.*
massif.out.*
perf.data*

# ---- NOT ignored, deliberately ---------------------------------------------
# assets/**/*.bmp and assets/**/*.json ARE committed. Week 9's milestone check
# is a fresh clone on another machine loading the same scene, and the classic
# failure is an asset that only ever existed on the author's disk.
!assets/**
