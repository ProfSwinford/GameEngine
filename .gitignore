# ---- Build output ----------------------------------------------------------
# Everything CMake generates. Nothing in here belongs in version control:
# it is machine-specific, it is enormous, and it is reproducible from source.
build/
build_output/
out/
cmake-build-*/

# ---- Fetched dependencies --------------------------------------------------
# FetchContent puts SDL, doctest, nlohmann_json and ImGui inside build/, so
# the line above already covers them. Listed explicitly in case you ever
# relocate FETCHCONTENT_BASE_DIR.
_deps/

# ---- IDE and editor --------------------------------------------------------
.vs/
.vscode/
!.vscode/settings.json
.idea/
*.user
*.suo
*.sln
*.sln.docstates
*.vcxproj*
CMakeUserPresets.json
IntelGraphicsProfiles/

# ---- Compiler and linker artefacts -----------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.idb
*.ilk
*.exp
*.tlog
*.lastbuildstate

# ---- Runtime output --------------------------------------------------------
# The log file is written here while the program runs. It is output, not
# source, so it is not committed.
logs/
*.log

# The editor writes imgui.ini to remember how you arranged the panels.
# A window arrangement is a personal preference, not source.
imgui.ini

# ---- OS noise --------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Tool output -----------------------------------------------------------
# Reports produced by profiling and analysis tools. Output, not source.
#
*.trace
*.heaptrack.*
callgrind.out.*
massif.out.*
perf.data*

# ---- NOT ignored, deliberately ---------------------------------------------
# assets/**/*.bmp and assets/**/*.json ARE committed on purpose. The classic
# failure is a scene that works on the author's machine and nowhere else,
# because an image was never added to version control.
!assets/**
